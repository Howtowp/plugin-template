<?xml version="1.0"?>
<ruleset name="Plugin Template">
	<description>WordPress Coding Standards (WPCS 3.4) for Plugin Template.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<!-- Minimum supported WordPress (WPCS 3 name; older WPCS called it minimum_supported_wp_version). -->
	<config name="minimum_wp_version" value="6.8"/>
	<!-- PHP versions to check for compatibility: 8.1 and up. -->
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Guidance only: warn above 150 characters, never error. Aim for 100-120 in new code. -->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="150"/>
			<property name="absoluteLineLimit" value="0"/>
		</properties>
	</rule>

	<!-- "Silence is golden" index.php files carry no file docblock. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/index.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="plugin-template"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="HowToWP\PluginTemplate"/>
				<element value="htw_pt"/>
				<element value="HTW_PT"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files are named after the class (Plugin.php), not class-plugin.php. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>
</ruleset>
